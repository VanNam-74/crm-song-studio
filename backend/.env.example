DATABASE_URL=postgresql+asyncpg://song:song@localhost:5432/create_song
REDIS_URL=redis://localhost:6379/0

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Public URL WordPress uses to reach this server (Cloudflare Tunnel hostname)
PUBLIC_BASE_URL=https://studio.example.com

WEBHOOK_TOLERANCE_SECONDS=300
ONE_DAY_HOURS=24
THREE_DAY_HOURS=72
DEFAULT_DELIVERY_OPTION=3_day

# false = do not push to Celery yet (useful before the worker exists)
ENQUEUE_TASKS=true

# Internal admin login
SESSION_TTL_HOURS=12
# true in production (https). false only for http://localhost dev
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
